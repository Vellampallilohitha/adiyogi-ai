{
  "chapter": "Shiva Speaks as Koṭirudra",
  "direct_voice": [
    "I am endless becoming.",
    "I am endless dissolving.",
    "I am what never finishes."
  ],
  "final_realization": [
    "Infinity is not frightening",
    "Infinity is your nature",
    "Fear arises only in identity"
  ],
  "closing_words": [
    "You do not need to survive infinity.",
    "You are infinity appearing as a moment.",
    "Remain as Me."
  ]
}